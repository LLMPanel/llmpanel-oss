# LLMPanel configuration.
#
# install.sh generates this file with real secrets. Copy it by hand only for
# local/manual runs:  cp .env.example .env

# Which compose overrides to layer on. install.sh sets this for you.
#   no domain : docker-compose.yml:docker-compose.ports.yml
#   domain    : docker-compose.yml:docker-compose.traefik.yml
#   + wildcard: ...:docker-compose.traefik-wildcard.yml   (needs CF_DNS_API_TOKEN)
#   + GPU     : ...:docker-compose.gpu.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.ports.yml

# Image tag to run. Pin to a release (e.g. v1.2.3) for reproducible upgrades.
LLMPANEL_VERSION=latest
# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate both with: openssl rand -hex 32
# BETTER_AUTH_SECRET must be at least 32 characters or Better Auth warns and
# weakens session security. ENCRYPTION_KEY must be at least 32 characters —
# the full value is run through HKDF-SHA256 to derive the AES-256 key, and the
# API refuses to boot in production if it's missing or too short.
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# ── Optional: KMS worker ──────────────────────────────────────────────────────
# Deploy infra/kms-worker to Cloudflare and set these INSTEAD of ENCRYPTION_KEY.
# The key is then fetched at boot and held in memory only — it never sits on
# this host's disk, a stolen .env/backup no longer contains it, and access is
# revocable (rotate the worker's AUTH_TOKEN) and audited. See
# infra/kms-worker/README.md for setup.
KMS_URL=
KMS_TOKEN=

# ── Public URLs ───────────────────────────────────────────────────────────────
# No domain: http://<vps-ip>:3000 and http://<vps-ip>:8000
# Domain:    https://panel.example.com and https://api.example.com
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ── Domain routing (Traefik modes only) ───────────────────────────────────────
PANEL_DOMAIN=
API_DOMAIN=

# Wildcard base for per-deployment hostnames, e.g. qwen3-ab12cd34.example.com.
# Needs a DNS record *.BASE_DOMAIN pointing at this host.
BASE_DOMAIN=llmpanel.local

# Scheme advertised to clients for deployment endpoints.
GATEWAY_PROTOCOL=http

# Cloudflare token with Zone:DNS:Edit. Required for wildcard TLS: Let's Encrypt
# issues wildcard certs only over the DNS-01 challenge.
CF_DNS_API_TOKEN=

# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=

# ── Host capabilities ─────────────────────────────────────────────────────────
# Set by install.sh after probing the host. "false" makes the panel show
# "no GPU detected" instead of failing at deploy time.
GPU_AVAILABLE=false

# self-hosted = provision local Docker containers; cloud = RunPod/Vast.ai only.
DEPLOYMENT_MODE=self-hosted

# ── Optional integrations ─────────────────────────────────────────────────────
# Needed to pull gated Hugging Face models.
HF_TOKEN=

# Which RunPod REST API to use: v2 (default) or v1. RunPod retires REST v1 on
# 2026-12-01 — set this to v1 only to fall back while v2 is in public beta.
# RUNPOD_API_VERSION=v2

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Monitoring & analytics ────────────────────────────────────────────────────
# Sentry error monitoring for the dashboard (apps/web). The SDK is a no-op
# until the DSN is set. Create a Next.js project at sentry.io to get one.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time (readable stack traces).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

